@article{labat1956,
  author    = {Labat, Ren\'e},
  title     = {Une nouvelle tablette de pronostics m\'edicaux},
  journal   = {Syria},
  volume    = {33},
  year      = {1956},
  pages     = {119--130},
  note      = {Editio princeps of 2 NB 336 (= 2 N-T 336 = IM 57947), a
               Kassite (Middle Babylonian) diagnostic/prognostic tablet from
               Nippur. Its colophon (PAP 2 \v{S}U 49 = 169 lines; DUB-2-K\'AM
               ana mar\d{s}i ina te\d{h}\^eka) identifies it as the second
               tablet of a pre-canonical Nippur series, which Labat argues is
               independent of AND anterior to the classical handbook. Labat
               dates it Kassite (late Middle Babylonian) on paleography
               (p.128); it was excavated from a Neo-Babylonian layer (whence
               eBL's NB tag), but its Kassite script secures the earlier date
               of composition. Labat's transcription normalizes logograms to
               Akkadian readings (e.g. ZAG/KAB rendered imitti/\v{s}um\=eli);
               the sign-level reading in data/middle/diagnostic was collated
               against his copy and photo (pl. V--VII)}
}

