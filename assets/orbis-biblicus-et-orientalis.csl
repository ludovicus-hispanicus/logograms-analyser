<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="en-US" demote-non-dropping-particle="sort-only">
  <info>
    <title>Orbis Biblicus et Orientalis (OBO)</title>
    <title-short>OBO</title-short>
    <id>http://www.zotero.org/styles/orbis-biblicus-et-orientalis</id>
    <link href="http://www.zotero.org/styles/orbis-biblicus-et-orientalis" rel="self"/>
    <author>
      <name>Luis Saenz</name>
    </author>
    <category citation-format="note"/>
    <category field="religion"/>
    <category field="history"/>
    <summary>Author-date style for the Orbis Biblicus et Orientalis series (University of Fribourg / Vandenhoeck &amp; Ruprecht). Short author-year references in footnotes; full author-date bibliography.</summary>
    <updated>2026-09-23T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License.</rights>
  </info>

  <locale xml:lang="en">
    <!-- OBO puts the comma outside the closing quote:
         "…Jerusalem and Samaria", in: M. Kartveit & G. N. Knoppers (eds.)
         The en-US default would pull it inside. -->
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="in">in</term>
    </terms>
  </locale>

  <!-- Primary creator, bibliography: Family, Given / Family, Given  (+ "(eds.)" if edited) -->
  <macro name="author-bib">
    <choose>
      <if variable="author">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=", " delimiter=" / " delimiter-precedes-last="always"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " delimiter=" / " delimiter-precedes-last="always"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- Primary creator, footnote: family names only, joined by " / " -->
  <macro name="author-short">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short" delimiter=" / "/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name form="short" delimiter=" / "/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- Volume editors inside a chapter. Two are spelled out and joined with "&",
       as in the OBO template ("in: M. Kartveit & G. N. Knoppers (eds.)"); three
       or more collapse to "et al.", as printed in OBO ("in: A. Brita et al.
       (eds.)"). et al. is roman in print, so no <et-al> override is needed. -->
  <macro name="editor-in">
    <names variable="editor" prefix="in: ">
      <name and="symbol" initialize-with=". " delimiter=", " delimiter-precedes-last="never"
            et-al-min="3" et-al-use-first="1"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="series">
    <group delimiter=" " prefix="(" suffix=")">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <!-- Year + disambiguating letter, rendered together so it prints "2010a" not "2010 a" -->
  <macro name="year-disambig">
    <group>
      <text macro="year"/>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <!-- Author. Year(a/b/c) -->
  <macro name="head">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year-disambig"/>
    </group>
  </macro>

  <!-- Trailing online access: the bare URL, with no access date.
       The guidelines allow a URL "only when necessary, especially in case of a
       digital-only publication", so it prints only for a work with no printed
       locus: an explicitly online type, or one carrying neither pages nor a
       place of publication. A printed book or chapter that happens to have a
       scan online (Maul 1997, Winitzer 2017) therefore prints none.

       The test is on publisher-place, not publisher. An eBL edition may well
       name the LMU as its publisher, and testing that field made the URL of
       EAE 55 and 57 disappear the moment one was entered; only something
       printed has a place. -->
  <macro name="access">
    <choose>
      <if type="webpage post-weblog dataset software" match="any">
        <text macro="access-url"/>
      </if>
      <else-if variable="page publisher-place" match="none">
        <text macro="access-url"/>
      </else-if>
    </choose>
  </macro>

  <!-- The URL alone. Access dates are kept in the footnotes, where a particular
       state of an eBL edition is being cited; the bibliography names the resource
       rather than a reading of it, so it carries none. -->
  <macro name="access-url">
    <text variable="URL"/>
  </macro>

  <citation disambiguate-add-year-suffix="true">
    <layout delimiter="; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year-disambig"/>
        </group>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-short"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="head"/>
        <choose>

          <!-- Chapter / contribution in an edited volume -->
          <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
            <group delimiter=". ">
              <!-- One delimiter, not fixed prefixes: a chapter in a volume with no
                   editor recorded (Falkenstein 1966) otherwise printed the comma
                   twice, once for the title suffix and once for the container. -->
              <group delimiter=", ">
                <text variable="title" quotes="true"/>
                <text macro="editor-in"/>
                <group delimiter=" ">
                  <text variable="container-title" font-style="italic"/>
                  <text macro="series"/>
                </group>
              </group>
              <group delimiter=", ">
                <text macro="publisher"/>
                <text variable="page"/>
              </group>
            </group>
          </if>

          <!-- Journal / periodical article -->
          <else-if type="article-journal article-magazine article-newspaper review review-book" match="any">
            <group>
              <text variable="title" quotes="true"/>
              <group delimiter=" " prefix=": ">
                <text variable="container-title" font-style="italic"/>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page" prefix=", "/>
            </group>
          </else-if>

          <!-- Thesis / dissertation -->
          <else-if type="thesis" match="any">
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="title" font-style="italic"/>
                <group prefix="(" suffix=")" delimiter=", ">
                  <text variable="genre"/>
                  <text variable="publisher"/>
                </group>
              </group>
              <text variable="publisher-place"/>
            </group>
          </else-if>

          <!-- Report / working paper -->
          <else-if type="report" match="any">
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="title" font-style="italic"/>
                <group prefix="(" suffix=")" delimiter=" ">
                  <text variable="genre"/>
                  <text variable="number"/>
                </group>
                <text macro="series"/>
              </group>
              <text macro="publisher"/>
            </group>
          </else-if>

          <!-- Webpage / online resource: "Title": Website Name. URL (accessed ...) -->
          <!-- URL + accessed date are added for every type by the trailing "access" macro below. -->
          <else-if type="webpage post-weblog dataset software" match="any">
            <group delimiter=". ">
              <group>
                <text variable="title" quotes="true"/>
                <text variable="container-title" font-style="italic" prefix=": "/>
              </group>
              <text macro="publisher"/>
            </group>
          </else-if>

          <!-- Monograph / edited book -->
          <else>
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="title" font-style="italic"/>
                <text macro="series"/>
              </group>
              <text macro="publisher"/>
            </group>
          </else>

        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
